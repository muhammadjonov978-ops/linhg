# ================= LINGOHUB — .env sozlamalari =================
# Bu faylni .env deb nusxalab, o'z qiymatlaringizni kiriting:
#   cp .env.example .env
#
# VITE_ prefiksli o'zgaruvchilar brauzerga yetkaziladi — hech qachon
# server maxfiyligini (masalan, Firebase xizmat hisobi kaliti) qo'ymang!

# ---- FIREBASE (Google orqali kirish + real vaqt tashrif hisoblagichi) ----
# https://console.firebase.google.com → Yangi loyiha → loyihangiz sozlamalari
# (uyg'urma belgisi ⚙️ → Project settings) → sizning web-app konfiguratsiyangiz
# Bundan tashqari: Authentication → Sign-in method → Google → Enable qilish kerak
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- GOOGLE OAUTH (qo'shimcha, istalgan) ----
# https://console.cloud.google.com/apis/credentials → OAuth Client ID (Web)
# Faqat Firebase ishlatilmaydigan ssenariylar uchun kerak
VITE_GOOGLE_CLIENT_ID=

# ---- HAQIQIY TO'LOVLAR (Payme + Click) ----
# VITE_ prefiksli o'zgaruvchilar brauzerga ko'rinadi — ular maxfiy EMAS
# (checkout havolasida ham ko'rinadi, shuning uchun xavfsiz).
#
# Payme kabineti: https://payme.uz → Kassa → Merchant ID
VITE_PAYME_MERCHANT_ID=
# Click kabineti: https://click.uz → Merchant ID va Service ID
VITE_CLICK_MERCHANT_ID=
VITE_CLICK_SERVICE_ID=
# Saytning to'liq manzili (return_url uchun; agar bo'sh bo'lsa avtomatik aniqlanadi)
VITE_SITE_URL=https://lingohub.uz

# ---- SERVER-SIDE maxfiy kalitlar (Vercel → Settings → Environment Variables) ----
# VITE_ PREFIKSISIZ yoziladi! Brauzerga yetib bormasligi kerak.
# Payme KEY — Payme kabinetidagi xizmat kaliti (webhook'ni autentifikatsiya qiladi)
PAYME_KEY=
# Payme kabinetidagi account maydon nomi (odatda "order_id")
PAYME_ACCOUNT_FIELD=order_id
# Click maxfiy kaliti — Click kabinetidagi SECRET_KEY (sign tekshirish uchun)
CLICK_SECRET_KEY=
# Pro (premium) narxlari — server-side tasdiqlash uchun (api/payment/create.js).
# Default: 49000 / 490000 (src/config.js dagi narxlar bilan bir xil bo'lishi shart).
# Narxni o'zgartirsangiz ikkala joyda ham yangilang!
PREMIUM_MONTHLY_PRICE=49000
PREMIUM_YEARLY_PRICE=490000

# ---- UPSTASH REDIS (to'lov buyurtmalarini saqlash) ----
# https://console.upstash.com → Database yaratish → REST API
# Bepul rejimda 10 000 ta so'rov/oy yetarli.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- SMS ESLATMA (ixtiyoriy, backend talab qiladi) ----
VITE_SMS_API_KEY=
VITE_SMS_BACKEND_URL=

# ---- GOOGLE SEARCH CONSOLE (Admin panel statistikasi, ixtiyoriy) ----
VITE_GSC_WORKER_URL=
