# ============================================================
# Lingohub.uz — Environment variables
# Ushbu faylni .env deb nusxalab, o'z qiymatlaringizni kiriting:
#   cp .env.example .env
# .env fayli git'ga qo'shilmaydi (maxfiy kalitlar uchun).
# To'liq qo'llanma: README.md → "To'lov tizimi (Payme)"
# ============================================================

# ------------------------------------------------------------
# FRONTEND (VITE_ prefiksli — brauzerga ko'rinadi, MAXFIY EMAS)
# ------------------------------------------------------------

# Payme merchant ID — Payme kabinetida (business.payme.uz) "Kassa" sozlamalaridan
# https://lingohub.uz/api/payme/webhook ni ulash paytida ko'rinadi
VITE_PAYME_MERCHANT_ID=

# Click (ixtiyoriy) — faqat Click ham qo'shmoqchi bo'lsangiz
VITE_CLICK_MERCHANT_ID=
VITE_CLICK_SERVICE_ID=

# Sayt manzili (return_url uchun)
VITE_SITE_URL=https://lingohub.uz

# Google auth (ixtiyoriy)
VITE_GOOGLE_CLIENT_ID=

# SMS reminder (ixtiyoriy)
VITE_SMS_API_KEY=
VITE_SMS_BACKEND_URL=

# ------------------------------------------------------------
# SERVER-SIDE (VITE_ PREFIKSISIZ — faqat api/ funksiyalarida,
# brauzerga CHIQMAYDI, MAXFIY)
# ------------------------------------------------------------

# Payme KEY — Payme kabinetida generatsiya qilinadi (maxfiy!)
PAYME_KEY=
# Payme account maydoni nomi — odatda order_id (o'zgartirmang)
PAYME_ACCOUNT_FIELD=order_id

# Click secret key (ixtiyoriy)
CLICK_SECRET_KEY=

# Upstash Redis (order'larni saqlash uchun) — https://console.upstash.com
# ⚠️ MAJBURIY! Bu bo'lmasa to'lov butunlay ishlamaydi:
#   POST /api/payment/create → "KV sozlanmagan"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pro obuna narxlari (server-side tasdiqlash) — src/config.js bilan bir xil bo'lishi shart
PREMIUM_MONTHLY_PRICE=49000
PREMIUM_YEARLY_PRICE=490000

# ------------------------------------------------------------
# ADMIN PANEL (server-side login) — brauzer kodiga parol CHIQMAYDI
# ------------------------------------------------------------

# Admin paroli — login: shxsh. Agar bu bo'sh qoldirilsa, default parol 'shshsh'
# ishlatiladi (panel darhol ishlaydi). Haqiqiy saytda kuchli parol qo'yish tavsiya etiladi.
ADMIN_PASSWORD=shshsh

# Egasining logini/ismi (ixtiyoriy, default: shxsh / Shox)
ADMIN_USERNAME=shxsh
ADMIN_NAME=Shox

# Token imzosi uchun maxfiy kalit (ixtiyoriy — bo'sh bo'lsa ADMIN_PASSWORD ishlatiladi)
ADMIN_TOKEN_SECRET=

# Qo'shimcha adminlar (ixtiyoriy): login:parol:Ism,login2:parol2:Ism2
ADMIN_EXTRA_ACCOUNTS=
#
# 💡 Panel'ning "Hisoblar" bo'limida ham yangi adminlar yaratish mumkin —
# ular endi HAQIQIY ishlaydi: Redis'da saqlanadi (Redis bo'lmasa vaqtincha
# xotirada — demo rejim). Parol faqat server'da turadi.

# ------------------------------------------------------------
# TELEGRAM BOT (server-side) — xabarnomalar + bot buyruqlari
# ------------------------------------------------------------

# Bot token — @BotFather dan olinadi (maxfiy!).
# ⚠️ Bu fayl git'ga qo'shiladi — haqiqiy token shu yerga YOZILMAYDI!
# Haqiqiy token faqat .env (git'ga qo'shilmaydi) va Vercel env'lariga yoziladi.
TELEGRAM_BOT_TOKEN=

# Egasining chat ID — botga /start yuborganingizdan keyin bot uni avtomatik
# eslab qoladi, lekin qo'lda ham qo'yish mumkin:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=
