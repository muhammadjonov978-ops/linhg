# ==== LINGOHUB — Third-party service keys ====
# Copy this file to .env and fill in your real values to enable:
#   1. Google sign-in  (VITE_GOOGLE_CLIENT_ID)
#   2. Card payments    (VITE_PAYME_MERCHANT_ID / VITE_CLICK_MERCHANT_ID)
#   3. SMS reminders    (VITE_SMS_API_KEY + VITE_SMS_BACKEND_URL)

# Google OAuth Client ID
# Create one: https://console.cloud.google.com/apis/credentials
# (Authorized JavaScript origins must include your site URL)
VITE_GOOGLE_CLIENT_ID=

# Payme merchant ID (https://merchant.payme.uz)
VITE_PAYME_MERCHANT_ID=

# Click merchant ID (https://click.uz)
VITE_CLICK_MERCHANT_ID=

# Eskiz SMS API key (https://eskiz.uz)
VITE_SMS_API_KEY=

# Your backend endpoint that actually sends the SMS (browsers cannot send SMS directly)
VITE_SMS_BACKEND_URL=

# ==== FIREBASE REALTIME DATABASE — LIVE VISITOR COUNTER ====
# Fill these to enable a REAL cross-device live "how many people are online"
# counter (site + admin panel). Create a free project: console.firebase.google.com
# -> Build -> Realtime Database -> Create database -> "Start in test mode".
# Then: Project settings -> General -> Your apps -> (web app) -> Config.
# If left empty, the app runs in DEMO mode (same-browser counting only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
