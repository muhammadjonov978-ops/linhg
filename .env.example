# ================= LINGOHUB — .env sozlamalari =================
# Bu faylni .env deb nusxalab, o'z qiymatlaringizni kiriting:
#   cp .env.example .env
#
# VITE_ prefiksli o'zgaruvchilar brauzerga yetkaziladi — hech qachon
# server maxfiyligini (masalan, Firebase xizmat hisobi kaliti) qo'ymang!

# ---- FIREBASE (Google orqali kirish + real vaqt tashrif hisoblagichi) ----
# https://console.firebase.google.com → Yangi loyiha → loyihangiz sozlamalari
# (uyg'urma belgisi ⚙️ → Project settings) → sizning web-app konfiguratsiyangiz
# Bundan tashqari: Authentication → Sign-in method → Google → Enable qilish kerak
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- GOOGLE OAUTH (qo'shimcha, istalgan) ----
# https://console.cloud.google.com/apis/credentials → OAuth Client ID (Web)
# Faqat Firebase ishlatilmaydigan ssenariylar uchun kerak
VITE_GOOGLE_CLIENT_ID=

# ---- TO'LOVLAR (ixtiyoriy) ----
VITE_PAYME_MERCHANT_ID=
VITE_CLICK_MERCHANT_ID=

# ---- SMS ESLATMA (ixtiyoriy, backend talab qiladi) ----
VITE_SMS_API_KEY=
VITE_SMS_BACKEND_URL=

# ---- GOOGLE SEARCH CONSOLE (Admin panel statistikasi, ixtiyoriy) ----
VITE_GSC_WORKER_URL=
